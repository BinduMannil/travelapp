{
  "people": {
    "summary": "Japanese social life runs on quiet consideration of others. Expect politeness by default, low public volume, strict queueing, punctuality, and mutual privacy. Visitors earn a lot of goodwill by matching that register.",
    "traits": [
      {
        "title": "Quiet in public",
        "body": "Phone calls on trains are considered rude. Keep voices low in restaurants and shrines."
      },
      {
        "title": "Queueing is sacred",
        "body": "Lines form for trains (at the marked floor stripes), elevators, food stalls, and even for pressing the walk button at some crossings. Never jump a queue."
      },
      {
        "title": "Bowing as greeting",
        "body": "A short nod works for tourists. Handshakes are fine in business; don't both bow and shake at once. Don't kiss on the cheek."
      },
      {
        "title": "Punctuality",
        "body": "Trains leave to the second. If you're 10 minutes late for a reservation, call ahead or risk forfeiting the table."
      },
      {
        "title": "Gift-giving",
        "body": "A small wrapped gift (omiyage) from your home country is a thoughtful gesture for a host, guide, or friend. Hand over with two hands."
      },
      {
        "title": "Shoes off",
        "body": "Remove shoes at private homes, ryokan, many temples' inner halls, some restaurants (watch for a raised entryway called a genkan and a shoe cubby)."
      },
      {
        "title": "Cash etiquette",
        "body": "Place cash or cards on the small tray at the register rather than handing directly to the cashier. They'll do the same when giving change."
      },
      {
        "title": "Saying no",
        "body": "Direct refusal is rare. 'Chotto muzukashii' (a little difficult) or a sharp intake of breath often means 'no'."
      },
      {
        "title": "Tattoos",
        "body": "Tattoos still carry yakuza associations for older generations — covered in onsen, gyms, and some pools. Many tattoo-friendly spots now exist; check ahead."
      },
      {
        "title": "Photos of people",
        "body": "Ask before photographing individuals, especially geisha in Gion and shrine visitors in ceremonial dress. Some alleys in Gion now ban photography outright."
      }
    ]
  },
  "dress_codes": [
    {
      "context": "temple_shrine",
      "label": "Temples and shrines",
      "requirement": "modest",
      "notes": "Shoulders and knees covered inside main halls. Loose, comfortable clothing works. Shoes must come off at the entrance to inner halls."
    },
    {
      "context": "onsen",
      "label": "Onsen (hot spring bath)",
      "requirement": "nude",
      "notes": "Bathing is done nude — swimwear is not allowed. You bring a small modesty towel. Shower thoroughly before entering the pool."
    },
    {
      "context": "upscale_restaurant",
      "label": "Upscale restaurant",
      "requirement": "smart_casual",
      "notes": "Michelin and fine-dining venues expect collared shirts / blouses, long trousers or a dress. Shorts, beach sandals, and tank tops will usually be turned away."
    },
    {
      "context": "club",
      "label": "Clubs (Shibuya / Roppongi)",
      "requirement": "smart_casual",
      "notes": "Doormen often refuse athletic wear, shorts, and sandals. Sneakers are fine as long as they're clean."
    },
    {
      "context": "business",
      "label": "Business meetings",
      "requirement": "formal",
      "notes": "Suit and tie for men, conservative business attire for women. Bring a business-card holder for meishi (cards) exchanged with two hands."
    },
    {
      "context": "general",
      "label": "Day-to-day sightseeing",
      "requirement": "casual",
      "notes": "Anything clean and comfortable. Tokyoites dress up more than many Western cities — trainers are fine but very revealing clothing stands out. "
    }
  ],
