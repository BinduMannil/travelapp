# ============================================================================
# Travel companion — environment variables
# Copy this file to `.env.local` and fill in whatever you have.
#
# ABSOLUTELY NONE of these are required for the site to run. Every outbound
# link works without an affiliate ID; the `affiliateUrl` helper simply leaves
# the URL unchanged when the env var is empty. Fill in as you sign up for
# each partner program and monetisation is instant.
# ============================================================================


# --- Supabase (required only for auth + saved trips + UGC; Week 4) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


# --- Third-party data APIs (optional; only for paid chunks at the end) ------
# OpenWeather — live forecast on weather page (free tier is fine)
OPENWEATHER_API_KEY=

# Google Places — photo + coord enrichment for Tier 2 cities
GOOGLE_PLACES_API_KEY=

# Anthropic — AI concierge + content generation for Tier 2 cities
ANTHROPIC_API_KEY=

# Exchange-rate fallback (if we outgrow Frankfurter's no-auth free tier)
EXCHANGE_API_KEY=

# Upstash Redis (rate limits + FX + API caching). Free tier works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# --- Affiliate programs -----------------------------------------------------
# Fill in the IDs you get from each partner's dashboard. Links auto-tag
# everywhere in the app. Missing values leave the URL untagged (no harm).

# Booking.com — Hotels. https://www.booking.com/affiliate-program/
NEXT_PUBLIC_AFF_BOOKING_AID=

# Agoda — Hotels (strong for Asia). https://partners.agoda.com/
NEXT_PUBLIC_AFF_AGODA_CID=

# Klook — Asia tours, attraction tickets, transit. https://affiliate.klook.com/
NEXT_PUBLIC_AFF_KLOOK_AID=

# GetYourGuide — Tours worldwide. https://partner.getyourguide.com/
NEXT_PUBLIC_AFF_GYG_PARTNER_ID=

# Viator — Tours. https://www.viator.com/affiliate
NEXT_PUBLIC_AFF_VIATOR_MCID=

# JTB — Japan-specialist tours (e.g. Ghibli Museum). Contact directly.
NEXT_PUBLIC_AFF_JTB_ID=

# SafetyWing — Nomad insurance. https://safetywing.com/affiliates
NEXT_PUBLIC_AFF_SAFETYWING_ID=

# Heymondo — Travel insurance (EU-friendly). https://www.heymondo.com/affiliates
NEXT_PUBLIC_AFF_HEYMONDO_ID=

# Airalo — eSIM. https://partners.airalo.com/
NEXT_PUBLIC_AFF_AIRALO_REF=

# Holafly — Unlimited-data eSIM. https://esim.holafly.com/affiliate-program/
NEXT_PUBLIC_AFF_HOLAFLY_REF=

# Welcome Pickups — Airport transfers.
# https://www.welcomepickups.com/for-partners/
NEXT_PUBLIC_AFF_WELCOMEPICKUPS_ID=

# Bounce — Luggage storage. https://usebounce.com/partners
NEXT_PUBLIC_AFF_BOUNCE_REF=

# Wise — FX card + money transfer. https://wise.com/campaigns/referrals
NEXT_PUBLIC_AFF_WISE_REF=

# Skyscanner — Flights. https://www.partners.skyscanner.net/
NEXT_PUBLIC_AFF_SKYSCANNER_ASSOCID=

# Kiwi.com — Flights (alt). https://www.kiwi.com/affiliate-program/
NEXT_PUBLIC_AFF_KIWI_AFF_ID=

# Discover Cars — Rental-car aggregator. https://www.discovercars.com/partners
NEXT_PUBLIC_AFF_DISCOVERCARS_AID=

# Rentalcars.com — Rental cars (Booking Holdings). https://www.rentalcars.com/affiliate
NEXT_PUBLIC_AFF_RENTALCARS_AFFCODE=


# --- Anti-abuse (UGC) -------------------------------------------------------
TURNSTILE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=


# --- Observability ----------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com


# --- Cron + email -----------------------------------------------------------
CRON_SECRET=
RESEND_API_KEY=


# --- Billing (Passport Pro — post-launch) -----------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
